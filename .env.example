# ---- 唯一必填的两项 ----------------------------------------------------------
# 1) 大模型 API（兼容任意 OpenAI 兼容接口，本地 Ollama 亦可）
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat

# 本地 Ollama 示例：
# LLM_API_BASE=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b

# 2) 调研方向（多个方向用英文逗号分隔，长度 ≤ 200）
RESEARCH_TOPIC=AI Agent, 大模型商业化, 开源生态, 芯片

# ---- 以下均有默认值，可留空 --------------------------------------------------
# 启动时是否立即抓取一次（true/false），默认 true
FETCH_ON_STARTUP=true
# 覆盖默认配置文件所在目录（默认 ./config）
CONFIG_DIR=config
# 覆盖数据库路径（默认 data/smtm.db）
# DB_PATH=data/smtm.db
